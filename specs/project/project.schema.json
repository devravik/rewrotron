{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/project/project.schema.json",
  "title": "project.schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "image_digest": {
              "type": "string",
              "minLength": 1
            },
            "secret_refs": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": {
                "type": "string",
                "pattern": "^env:[A-Z_][A-Z0-9_]*$"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false
    },
    "target": {
      "$ref": "https://rewrotron.dev/specs/project/target.schema.json"
    },
    "environment": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "docker",
            "local"
          ]
        },
        "database": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "schema_policy": {
              "const": "retain"
            },
            "secret_ref": {
              "type": "string",
              "minLength": 1
            },
            "fixture_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "requirement": {
          "type": "string",
          "enum": [
            "strict",
            "approved_changes"
          ]
        },
        "active_session_continuity": {
          "type": "string",
          "enum": [
            "required",
            "approved_relogin"
          ]
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "production_access": {
          "const": "denied"
        },
        "external_writes": {
          "const": "denied"
        },
        "export_policy": {
          "type": "string",
          "enum": [
            "local_only",
            "reviewed_export"
          ]
        }
      },
      "required": [
        "production_access",
        "external_writes",
        "export_policy"
      ],
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "strategy": {
          "const": "vertical_slice"
        },
        "remove_dead_code": {
          "type": "boolean"
        },
        "preserve_dormant_code": {
          "const": true
        },
        "optimization": {
          "type": "object",
          "properties": {
            "enabled_after_parity": {
              "const": true
            }
          },
          "required": [
            "enabled_after_parity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "strategy",
        "remove_dead_code",
        "preserve_dormant_code",
        "optimization"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "project_id",
    "source",
    "environment",
    "safety"
  ],
  "additionalProperties": false
}
