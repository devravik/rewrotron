{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/project/execution-variant.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "original_manifest_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "original_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_manifest_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "variant_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transform_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "declared_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "before_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "after_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "before_ref",
          "after_ref",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "credential_policy_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "review_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "original_manifest_ref",
    "original_content_hash",
    "variant_manifest_ref",
    "variant_content_hash",
    "transform_ref",
    "declared_changes",
    "credential_policy_ref",
    "limitations",
    "review_evidence_refs"
  ],
  "additionalProperties": false
}
