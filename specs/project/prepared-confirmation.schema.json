{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/project/prepared-confirmation.schema.json",
  "title": "prepared-confirmation.schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "detection_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "merged_facts": {
      "type": "object"
    },
    "reviewed_payload_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "project_id",
    "detection_id",
    "subject_hash",
    "merged_facts",
    "reviewed_payload_ref"
  ],
  "additionalProperties": false
}
