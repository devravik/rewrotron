{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/project/work-scope.schema.json",
  "description": "Shared pre-plan source/work boundary for assessment and selected migration work; no executable corpus/cases required. Critical workflow and business requirement refs are descriptors/evidence, not interpreted contracts.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "source_snapshot_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "included_entrypoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "included_source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00\\\\]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "critical_workflow_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "constraint_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "business_requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "operational_profile_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded_scope_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "project_id",
    "source_snapshot_ref",
    "included_entrypoint_ids",
    "included_source_paths",
    "critical_workflow_refs",
    "constraint_refs",
    "business_requirement_refs",
    "operational_profile_ref",
    "excluded_scope_refs",
    "limitations"
  ],
  "additionalProperties": false
}
