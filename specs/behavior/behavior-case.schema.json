{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/behavior/behavior-case.schema.json",
  "description": "Version 1 is readable historical data only. Current execution requires version 2 plus service invariants.",
  "oneOf": [
    {
      "title": "behavior-case.schema",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/entrypoint"
        },
        "http_method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "HEAD"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "query_params": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "payload": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "preconditions": {
          "type": "object",
          "properties": {
            "fixture_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "principal_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "session_state": {
              "type": "object"
            },
            "secret_refs": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "fixture_refs"
          ],
          "additionalProperties": false
        },
        "expected_response": {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "redirect": {
              "type": "object"
            },
            "body": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "empty",
                    "json",
                    "html",
                    "text",
                    "binary"
                  ]
                },
                "artifact_ref": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "schema": {
                  "type": "object"
                },
                "assertions": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "exit_code": {
              "type": "integer"
            },
            "event_assertions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "required_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "http",
              "body",
              "authentication",
              "authorization",
              "session",
              "database",
              "external",
              "files",
              "cache",
              "errors",
              "execution"
            ]
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "workflow_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "request_case_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "extract": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9_-]+$"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "header",
                        "json_pointer",
                        "html_selector",
                        "cookie"
                      ]
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "source",
                    "selector"
                  ],
                  "additionalProperties": false
                }
              },
              "bindings": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "max_repeats": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "step_id",
              "operation_id",
              "request_case_id",
              "extract",
              "bindings",
              "max_repeats"
            ],
            "additionalProperties": false
          }
        },
        "comparison_policy_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "contract_id",
        "contract_version",
        "entrypoint",
        "headers",
        "preconditions",
        "expected_response",
        "required_dimensions",
        "comparison_policy_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entrypoint": {
                "properties": {
                  "type": {
                    "const": "http"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "then": {
            "required": [
              "http_method",
              "path"
            ],
            "properties": {
              "expected_response": {
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "contract_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "workflow_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "fixture_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "request_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_assertions": {
          "type": "array",
          "items": {
            "$ref": "https://rewrotron.dev/specs/behavior/semantics.schema.json#/$defs/expression"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "project_id",
        "contract_ref",
        "workflow_ref",
        "profile_ref",
        "fixture_refs",
        "request_refs",
        "policy_ref",
        "source_evidence_refs",
        "expected_assertions"
      ],
      "additionalProperties": false
    }
  ]
}
