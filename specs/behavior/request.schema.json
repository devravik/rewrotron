{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/behavior/request.schema.json",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "raw_target": {
      "type": "string",
      "pattern": "^/[^\\r\\n]*$"
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "body_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "method",
    "raw_target",
    "headers",
    "body_ref"
  ],
  "additionalProperties": false
}
