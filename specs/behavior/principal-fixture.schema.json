{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/behavior/principal-fixture.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "intended_subject": {
      "$ref": "https://rewrotron.dev/specs/behavior/evaluation-context.schema.json#/$defs/value"
    },
    "credential_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_session_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "db_identity_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "actor_id",
    "intended_subject",
    "credential_ref",
    "initial_session_ref",
    "db_identity_ref",
    "provenance_refs"
  ],
  "additionalProperties": false
}
