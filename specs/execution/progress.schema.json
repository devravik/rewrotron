{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/execution/progress.schema.json",
  "title": "Measured execution progress",
  "type": "object",
  "properties": {
    "metric_id": {
      "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/id"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "numerator": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "denominator": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "scope_hash": {
      "anyOf": [
        {
          "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_ref": {
      "anyOf": [
        {
          "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/artifact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "accounting_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "metric_id",
    "definition",
    "numerator",
    "denominator",
    "unit",
    "percent",
    "scope_hash",
    "basis_ref",
    "accounting_revision",
    "evidence_sequence",
    "freshness"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "denominator": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "numerator": {
            "const": 0
          },
          "percent": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "denominator": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "percent": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "numerator": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "percent": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "percent": {
            "type": "number"
          }
        }
      },
      "then": {
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          },
          "scope_hash": {
            "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/hash"
          },
          "basis_ref": {
            "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/artifact_ref"
          }
        }
      }
    }
  ]
}
