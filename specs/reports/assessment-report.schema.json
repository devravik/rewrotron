{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/reports/assessment-report.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "assessment_status": {
      "const": "COMPLETED"
    },
    "migration_feasibility": {
      "enum": [
        "VIABLE",
        "VIABLE_WITH_CONDITIONS",
        "BLOCKED",
        "UNKNOWN",
        "PARTIALLY_UNDERSTOOD"
      ]
    },
    "implementation_authorized": {
      "const": false
    },
    "as_of_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshot_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "detection_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target_intent_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "SOURCE_SNAPSHOT",
              "DETECTION",
              "TARGET_INTENT",
              "OPERATIONAL_PROFILE",
              "CONSTRAINTS",
              "BUSINESS_REQUIREMENTS",
              "ANALYSIS",
              "OBSERVATION",
              "DEPENDENCY",
              "ADAPTER",
              "POLICY",
              "EVIDENCE"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "analysis_record_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "validity_graph_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "system_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 1
    },
    "examined_scope": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "analysis_record_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "OBSERVED",
              "INFERRED",
              "UNKNOWN",
              "UNSUPPORTED",
              "RECOMMENDED"
            ]
          },
          "basis": {
            "enum": [
              "STATIC_ONLY",
              "RUNTIME",
              "USER_ASSERTION",
              "MIXED",
              "MISSING_EVIDENCE"
            ]
          },
          "category": {
            "enum": [
              "SYSTEM",
              "REQUIRED_CHANGE",
              "DEPENDENCY",
              "COMPATIBILITY",
              "RISK",
              "BLOCKER",
              "ALTERNATIVE",
              "UNKNOWN",
              "UNSUPPORTED",
              "MISSING_EVIDENCE",
              "CHARACTERIZATION",
              "ASSUMPTION",
              "RECOMMENDATION"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "provenance_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "prerequisite_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "recommended_action": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "finding_id",
          "analysis_record_ref",
          "classification",
          "basis",
          "category",
          "summary",
          "reason",
          "provenance_refs",
          "prerequisite_refs",
          "limitations",
          "affected_ids",
          "recommended_action"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "STATIC_ONLY"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "properties": {
                "limitations": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "MISSING_EVIDENCE"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "properties": {
                "classification": {
                  "enum": [
                    "UNKNOWN",
                    "UNSUPPORTED",
                    "INFERRED",
                    "RECOMMENDED"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "suggested_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "prerequisite_finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "position",
          "finding_ids",
          "action",
          "prerequisite_finding_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "effort_estimate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "lower": {
              "type": "number",
              "minimum": 0
            },
            "upper": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "PERSON_HOURS",
                "PERSON_DAYS"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "scope_ref",
            "lower",
            "upper",
            "unit",
            "method",
            "evidence_refs",
            "assumptions",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "assessment_id",
    "project_id",
    "assessment_status",
    "migration_feasibility",
    "implementation_authorized",
    "as_of_sequence",
    "created_at",
    "configuration_hash",
    "source_snapshot_ref",
    "detection_ref",
    "target_intent_ref",
    "scope_ref",
    "input_refs",
    "analysis_record_refs",
    "validity_graph_ref",
    "system_summary",
    "evidence_summary",
    "examined_scope",
    "findings",
    "missing_evidence",
    "assumptions",
    "uncertainty",
    "suggested_sequence",
    "effort_estimate"
  ],
  "additionalProperties": false,
  "description": "Immutable projection of shared assessed domain state; completion is independent of migration feasibility. Not a plan, verification verdict or approval.",
  "allOf": [
    {
      "if": {
        "properties": {
          "migration_feasibility": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "migration_feasibility"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "BLOCKER",
                    "UNSUPPORTED"
                  ]
                }
              },
              "required": [
                "category"
              ]
            }
          }
        }
      }
    }
  ]
}
