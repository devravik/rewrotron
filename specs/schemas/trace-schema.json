          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "observation_window": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            },
            "schedule_horizon_ms": {
              "type": "integer",
              "minimum": 0
            },
            "queue_state_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_beyond_horizon": {
              "type": "boolean"
            },
            "control_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "start",
            "end",
            "schedule_horizon_ms",
            "queue_state_ref",
            "due_beyond_horizon",
            "control_refs"
          ]
        }
      },
      "required": [
        "schema_version",
        "trace_id",
        "project_id",
        "configuration_hash",
        "entrypoint_type",
        "environment",
        "timestamp",
        "duration_ms",
        "completeness",
        "redaction",
        "causality",
        "attestation_refs",
        "profile_ref",
        "reset_report_ref",
        "effects_ref",
        "scenario_id",
        "execution_witness_ref",
        "local_identity_ref",
        "evaluation_context_ref",
        "step_occurrence_ref",
        "observation_window"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entrypoint_type": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "request",
              "response"
            ]
          },
          "else": {
            "required": [
              "execution"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "case_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            }
          }
        },
        {
          "properties": {
            "scenario_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            }
          }
        }
      ]
    }
  ]
}
