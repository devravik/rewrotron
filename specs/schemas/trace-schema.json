              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "authentication": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "authorization": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "session": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "database": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "external": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "files": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "cache": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "errors": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "PARTIAL",
                "UNAVAILABLE",
