{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/get-next-mission.schema.json",
  "title": "get-next-mission.schema",
  "type": "object",
  "properties": {
    "mission": {
      "oneOf": [
        {
          "$ref": "https://rewrotron.dev/specs/missions/mission.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "READY",
        "NO_WORK",
        "DEPENDENCIES_BLOCKED",
        "CONFIRMATION_REQUIRED"
      ]
    }
  },
  "required": [
    "mission",
    "reason"
  ],
  "additionalProperties": false
}
