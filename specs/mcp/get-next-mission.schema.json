{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/get-next-mission.schema.json",
  "title": "GetNextMissionResponse",
  "description": "Output schema for MCP research.get_next_mission",
  "type": "object",
  "required": ["mission_id", "type", "priority", "status"],
  "properties": {
    "mission_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "ANALYZE_SOURCE",
        "DISCOVER_ROUTE",
        "OBSERVE_WORKFLOW",
        "GENERATE_CONTRACT",
        "MIGRATE_UNIT",
        "VERIFY_CASE",
        "REPAIR_MISMATCH",
        "ANALYZE_DEAD_CODE",
        "BENCHMARK",
        "OPTIMIZE",
        "REVIEW_UNKNOWN"
      ]
    },
    "unit_id": { "type": ["string", "null"] },
    "case_id": { "type": ["string", "null"] },
    "description": { "type": "string" },
    "priority": { "type": "integer" },
    "status": { "type": "string" },
    "context": { "type": "object" }
  }
}
