{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/tools/knowledge.record_lesson.input.schema.json",
  "title": "knowledge.record_lesson.input.schema",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    }
  },
  "required": [
    "experiment_id",
    "finding",
    "remediation",
    "project_id",
    "idempotency_key"
  ],
  "additionalProperties": false
}
