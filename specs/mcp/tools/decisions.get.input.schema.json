{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/tools/decisions.get.input.schema.json",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    }
  },
  "required": [
    "decision_id",
    "project_id"
  ],
  "additionalProperties": false
}
