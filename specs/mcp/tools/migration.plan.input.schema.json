{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/tools/migration.plan.input.schema.json",
  "title": "migration.plan.input.schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "recalculate": {
      "type": "boolean"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    }
  },
  "required": [
    "project_id",
    "idempotency_key"
  ],
  "additionalProperties": false
}
