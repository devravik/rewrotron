{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/tools/project.confirm_cutover.input.schema.json",
  "title": "project.confirm_cutover.input.schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval_token": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    }
  },
  "required": [
    "project_id",
    "subject_hash",
    "approval_token",
    "idempotency_key"
  ],
  "additionalProperties": false
}
