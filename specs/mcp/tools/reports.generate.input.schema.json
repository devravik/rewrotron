{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/mcp/tools/reports.generate.input.schema.json",
  "title": "reports.generate.input.schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "json",
        "markdown"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "auto",
        "assessment",
        "migration"
      ],
      "default": "auto"
    },
    "assessment_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "project_id",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "description": "Rendering only: auto chooses assessed-state report before a plan, migration report after a plan; before Gate 1 only a detection summary. It does not acquire evidence or start/approve planning. An explicit assessment_ref retrieves that historical report.",
  "allOf": [
    {
      "if": {
        "required": [
          "assessment_ref"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "auto",
              "assessment"
            ]
          }
        }
      }
    }
  ]
}
