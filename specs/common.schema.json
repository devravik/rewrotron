{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/common.schema.json",
  "title": "common.schema",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "headers": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "STATIC",
            "RUNTIME",
            "USER_OVERRIDE",
            "AGENT_PROPOSAL"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "symbol_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "artifact_ref",
        "description"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "USER_ERROR",
            "ENVIRONMENT_ERROR",
            "SOURCE_ERROR",
            "TARGET_BUILD_ERROR",
            "ANALYSIS_ERROR",
            "OBSERVATION_ERROR",
            "VERIFICATION_ERROR",
            "AGENT_ERROR",
            "INTERNAL_ERROR"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        },
        "artifact_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "code",
        "message",
        "category",
        "retryable",
        "recommended_action"
      ],
      "additionalProperties": false
    },
    "entrypoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "http"
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS",
                "HEAD",
                "ANY"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "content_types": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "type",
            "method",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cli"
            },
            "command_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "arguments_schema": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "command_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cron"
            },
            "command_id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "command_id",
            "schedule",
            "timezone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "event"
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "message_schema": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "channel",
            "message_schema"
          ],
          "additionalProperties": false
        }
      ]
    },
    "completeness": {
      "type": "object",
      "properties": {
        "http": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "body": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "authentication": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "authorization": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "session": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "database": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "external": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "files": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "cache": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "errors": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        }
      },
      "required": [
        "http",
        "body",
        "authentication",
        "authorization",
        "session",
        "database",
        "external",
        "files",
        "cache",
        "errors",
        "execution"
      ],
      "additionalProperties": false
    },
    "artifact_policy": {
      "type": "object",
      "properties": {
        "visibility": {
          "enum": [
            "PRIVATE_SOURCE",
            "SANITIZED_EVIDENCE"
          ]
        },
        "policy_ref": {
          "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/artifact_ref"
        }
      },
      "required": [
        "visibility",
        "policy_ref"
      ],
      "additionalProperties": false
    }
  }
}
