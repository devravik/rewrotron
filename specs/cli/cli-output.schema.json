{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/cli-output.schema.json",
  "title": "cli-output.schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "data": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://rewrotron.dev/specs/common.schema.json#/$defs/error"
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "dry_run_summary": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "command",
    "success",
    "exit_code",
    "timestamp",
    "duration_ms",
    "data",
    "errors"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
