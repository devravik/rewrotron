{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/approval-issue.input.schema.json",
  "title": "approval-issue.input.schema",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "source",
        "plan",
        "cutover"
      ]
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "gate",
    "subject_hash"
  ],
  "additionalProperties": false
}
