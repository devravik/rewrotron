{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/confirm-source.input.schema.json",
  "title": "confirm-source.input.schema",
  "type": "object",
  "properties": {
    "detection_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "overrides": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "prepare": {
      "type": "boolean"
    }
  },
  "required": [
    "detection_id",
    "manifest_hash"
  ],
  "additionalProperties": false
}
