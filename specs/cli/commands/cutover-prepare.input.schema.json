{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/cutover-prepare.input.schema.json",
  "title": "cutover-prepare.input.schema",
  "type": "object",
  "properties": {
    "subject_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "subject_hash",
    "output"
  ],
  "additionalProperties": false
}
