{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/execution-show.input.schema.json",
  "title": "Execution page request",
  "type": "object",
  "properties": {
    "after_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "through_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "verbosity": {
      "enum": [
        "simple",
        "detailed",
        "developer"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
