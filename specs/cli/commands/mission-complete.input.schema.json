{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/mission-complete.input.schema.json",
  "title": "mission-complete.input.schema",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "mission_id",
    "fencing_token",
    "evidence_refs"
  ],
  "additionalProperties": false
}
