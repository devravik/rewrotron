{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/cli/commands/plan.input.schema.json",
  "title": "plan.input.schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "recalculate": {
      "type": "boolean"
    },
    "selection_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [],
  "additionalProperties": false,
  "description": "Requires supplied or current explicit human CONTINUE_PLANNING selection. Absent valid selection is a domain error; target/style assertions cannot replace it."
}
