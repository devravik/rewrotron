{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/adapters/qualification.schema.json",
  "description": "Engine-derived qualification of exact installed implementation/schema/profile/control bytes. Advertisements or agent-produced statuses cannot establish support.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "subject_kind": {
      "enum": [
        "ENGINE",
        "ADAPTER"
      ]
    },
    "implementation_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "input_profile_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "control_suite_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "control_result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED",
        "INCONCLUSIVE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "qualification_id",
    "project_id",
    "subject_kind",
    "implementation_ref",
    "schema_refs",
    "capability_ids",
    "input_profile_ref",
    "control_suite_ref",
    "control_result_refs",
    "limitations",
    "status",
    "reason_codes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "UNSUPPORTED",
              "INCONCLUSIVE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
