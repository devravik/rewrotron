        "validation_maturity",
        "implementation_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "implementation_status": {
                "const": "PLANNED"
              }
            }
          },
          "then": {
            "properties": {
              "validation_maturity": {
                "enum": [
                  "DESIGNED",
                  "SPECIFIED",
                  "STRUCTURALLY_VALIDATED"
                ]
              },
              "implementation_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "implementation_ref": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "validation_maturity": {
                "enum": [
                  "IMPLEMENTED",
                  "UNIT_TESTED",
                  "RUNTIME_VALIDATED",
                  "INTEGRATION_VALIDATED",
                  "RELEASE_VALIDATED"
                ]
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
