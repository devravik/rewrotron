{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/migration/plan.schema.json",
  "description": "Versions 1.0 and 2.0 remain readable history. Current executable envelopes require 2.1, an explicit assessment continuation selection and planning-basis refs bound through v2 PLAN subject decision_refs; cross-record equality/validity requires service checks.",
  "oneOf": [
    {
      "title": "plan.schema",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "behavior_ir_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_config": {
          "$ref": "https://rewrotron.dev/specs/project/target.schema.json"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "contract_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "case_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "priority": {
                "type": "integer",
                "minimum": 0
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "unit_id",
              "contract_ids",
              "case_ids",
              "dependencies",
              "priority",
              "capabilities"
            ],
            "additionalProperties": false
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "scope_exclusions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "affected_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "finding_id",
              "code",
              "severity",
              "affected_ids",
              "evidence_ids",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "decision_system": {
          "type": "object",
          "properties": {
            "target_spec_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "resolved_target": {
              "$ref": "https://rewrotron.dev/specs/project/target.schema.json"
            },
            "recommendation_decisions_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "dependency_resolution_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "feasibility_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "target_spec_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "target_spec_hash",
            "resolved_target",
            "recommendation_decisions_ref",
            "dependency_resolution_ref",
            "feasibility_ref",
            "target_spec_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "project_id",
        "plan_hash",
        "configuration_hash",
        "behavior_ir_hash",
        "corpus_hash",
        "policy_hash",
        "target_config",
        "units",
        "omissions",
        "scope_exclusions",
        "unresolved_items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject": {
          "$ref": "https://rewrotron.dev/specs/project/approval-subject.schema.json#/$defs/plan"
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "project_id",
        "plan_hash",
        "subject"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.1"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject": {
          "$ref": "https://rewrotron.dev/specs/project/approval-subject.schema.json#/$defs/plan"
        },
        "assessment_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "selection_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "planning_basis_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "project_id",
        "plan_hash",
        "subject",
        "assessment_ref",
        "selection_ref",
        "planning_basis_ref"
      ],
      "additionalProperties": false
    }
  ]
}
