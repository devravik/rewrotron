{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/migration/dependency-resolution.schema.json",
  "description": "Version 1 is readable historical data only. Current execution requires version 2 plus service invariants.",
  "oneOf": [
    {
      "title": "Usage and capability-based dependency resolution",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "dependency_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "target_spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "properties": {
            "ecosystem": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "ecosystem",
            "package",
            "version",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "source_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "affected_unit_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "required_capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "symbols",
            "source_files",
            "affected_unit_ids",
            "required_capabilities"
          ],
          "additionalProperties": false
        },
        "proposal": {
          "type": "object",
          "properties": {
            "strategy": {
              "enum": [
                "DIRECT_UPGRADE",
                "ADAPTER",
                "REPLACEMENT",
                "REIMPLEMENT",
                "RETAIN"
              ]
            },
            "package": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "adapter_required": {
              "type": "boolean"
            }
          },
          "required": [
            "strategy",
            "package",
            "version",
            "adapter_required"
          ],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "metadata": {
              "enum": [
                "COMPATIBLE",
                "INCOMPATIBLE",
                "PARTIAL",
                "UNKNOWN"
              ]
            },
            "used_api": {
              "enum": [
                "COMPATIBLE",
                "INCOMPATIBLE",
                "PARTIAL",
                "UNKNOWN"
              ]
            },
            "behavior": {
              "enum": [
                "PASS",
                "MISMATCH",
                "UNKNOWN"
              ]
            },
            "missing_capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "metadata",
            "used_api",
            "behavior",
            "missing_capabilities"
          ],
          "additionalProperties": false
        },
        "capability_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "COVERED",
                  "MISSING",
                  "UNKNOWN"
                ]
              },
              "case_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]+$"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "capability_id",
              "provider",
              "status",
              "case_ids",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitive_dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "decision": {
          "enum": [
            "PENDING",
            "ACCEPTED",
            "REJECTED",
            "DEFERRED",
            "SUPERSEDED"
          ]
        },
        "status": {
          "enum": [
            "PROPOSED",
            "PLANNED",
            "IMPLEMENTED",
            "VERIFIED",
            "BLOCKED",
            "SUPERSEDED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "dependency_id",
        "target_spec_hash",
        "source",
        "usage",
        "proposal",
        "compatibility",
        "capability_mappings",
        "transitive_dependency_ids",
        "decision",
        "status",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PLANNED",
                  "IMPLEMENTED",
                  "VERIFIED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "const": "ACCEPTED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "compatibility": {
                "properties": {
                  "behavior": {
                    "const": "PASS"
                  },
                  "missing_capabilities": {
                    "maxItems": 0
                  },
                  "metadata": {
                    "const": "COMPATIBLE"
                  },
                  "used_api": {
                    "const": "COMPATIBLE"
                  }
                }
              },
              "capability_mappings": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "COVERED"
                    },
                    "case_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
