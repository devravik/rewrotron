{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/migration/release.schema.json",
  "description": "v1 historical read-only; current service output v2.",
  "oneOf": [
    {
      "title": "release.schema",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "release_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependency_lock_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "verification_report_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "benchmark_report_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "cutover_runbook_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rollback_runbook_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "session_strategy_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scope_exclusions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "omission_report_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "release_hash",
        "configuration_hash",
        "plan_hash",
        "target_tree_hash",
        "dependency_lock_hashes",
        "verification_report_ref",
        "benchmark_report_ref",
        "cutover_runbook_ref",
        "rollback_runbook_ref",
        "session_strategy_ref",
        "scope_exclusions",
        "omission_report_ref"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "release_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject": {
          "$ref": "https://rewrotron.dev/specs/project/approval-subject.schema.json#/$defs/release"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "release_hash",
        "subject"
      ],
      "additionalProperties": false
    }
  ]
}
