              "target_peak_memory_mb": {
                "type": "number",
                "minimum": 0
              },
              "source_successes": {
                "type": "integer",
                "minimum": 0
              },
              "target_successes": {
                "type": "integer",
                "minimum": 0
              },
              "source_errors": {
                "type": "integer",
                "minimum": 0
              },
              "target_errors": {
                "type": "integer",
                "minimum": 0
              },
              "latency_ratio": {
                "type": "number",
                "minimum": 0
              },
              "memory_ratio": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "source_p95_ms",
              "target_p95_ms",
              "source_peak_memory_mb",
              "target_peak_memory_mb",
              "source_successes",
              "target_successes",
              "source_errors",
              "target_errors",
              "latency_ratio",
              "memory_ratio"
