  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "workflow_instance_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "binding_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "relation_group": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
