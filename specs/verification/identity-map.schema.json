                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "connection_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "logical_key": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "source_value": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value_type": {
                        "const": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value_type",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "value_type": {
                        "const": "integer"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^(?:0|-?[1-9][0-9]*)$"
                      }
                    },
                    "required": [
                      "value_type",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "target_value": {
