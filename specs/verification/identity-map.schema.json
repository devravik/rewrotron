                    "type": "object",
                    "properties": {
                      "value_type": {
                        "const": "integer"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^(?:0|-?[1-9][0-9]*)$"
                      }
                    },
                    "required": [
                      "value_type",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "binding_id",
              "relation_group",
              "actor_id",
              "connection_id",
              "logical_key",
              "source_value",
              "target_value",
              "evidence_refs"
            ],
            "additionalProperties": false
