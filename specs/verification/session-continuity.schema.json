{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/verification/session-continuity.schema.json",
  "description": "Plan-consumed bounded X19 semantic obligations; capture uses existing phase-qualified evaluation contexts. This contract never supplies observations, session codecs or approvals. Content address is sha256 of rwt-cjson-1 of this record.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "logical_workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "decision_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "strategy": {
      "enum": [
        "SAFE_BRIDGE",
        "REVIEWED_RELOGIN"
      ]
    },
    "codec_binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "codec_implementation_ref": {
      "type": "string",
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "codec_profile_ref": {
      "type": "string",
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "case_id",
    "logical_workflow_id",
    "decision_ref",
    "strategy",
    "codec_binding",
    "codec_implementation_ref",
    "codec_profile_ref",
    "checks",
    "relations"
  ],
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "SOURCE",
            "TARGET"
          ]
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "visit": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "PRE_OPERATION",
            "POST_OPERATION"
          ]
        },
        "actor_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "side",
        "step_id",
        "visit",
        "phase",
        "actor_ref"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "observation",
        "path"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_manifest_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "qualification_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "obligation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "minItems": 1
        },
        "input_shape_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "output_shape_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "capability_id",
        "provider_manifest_ref",
        "qualification_ref",
        "obligation_refs",
        "input_shape_ref",
        "output_shape_ref"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "predicate": {
          "$ref": "https://rewrotron.dev/specs/behavior/semantics.schema.json#/$defs/expression"
        }
      },
      "required": [
        "id",
        "observation",
        "predicate"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "left": {
          "$ref": "#/$defs/value"
        },
        "right": {
          "$ref": "#/$defs/value"
        },
        "different": {
          "type": "boolean"
        },
        "identity_rule_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "connection_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "left",
        "right",
        "different",
        "identity_rule_id",
        "actor_id",
        "connection_id"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "SAFE_BRIDGE"
          }
        }
      },
      "then": {
        "properties": {
          "codec_binding": {
            "$ref": "#/$defs/binding"
          },
          "codec_implementation_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "codec_profile_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
