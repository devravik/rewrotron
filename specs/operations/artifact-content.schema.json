{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/operations/artifact-content.schema.json",
  "title": "artifact-content.schema",
  "type": "object",
  "properties": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string"
    },
    "encoding": {
      "enum": [
        "utf8",
        "base64"
      ]
    },
    "content": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "artifact_ref",
    "media_type",
    "encoding",
    "content",
    "size_bytes"
  ],
  "additionalProperties": false
}
