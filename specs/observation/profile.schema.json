{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/observation/profile.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operational_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "HTTP",
              "CLI",
              "CRON",
              "WORKER",
              "CALLBACK",
              "PLUGIN",
              "CONFIG",
              "DATABASE_DISPATCH",
              "GENERATED_CODE"
            ]
          },
          "inventory_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mechanism_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "root_id",
          "kind",
          "inventory_ref",
          "mechanism_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "closed_boundary_evidence_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture_limits_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "connection_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "connection_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "catalog": {
            "type": "string",
            "minLength": 1
          },
          "settings_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reset_profile_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "connection_id",
          "catalog",
          "settings_ref",
          "reset_profile_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "store_profile_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completion_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "project_id",
    "environment_ref",
    "operational_roots",
    "required_dimensions",
    "closed_boundary_evidence_ref",
    "capture_limits_ref",
    "connection_profiles",
    "store_profile_refs",
    "completion_ref"
  ],
  "additionalProperties": false
}
