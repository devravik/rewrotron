{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rewrotron.dev/specs/observation/attestation.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "profile_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mechanism_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "dimension": {
            "enum": [
              "HTTP",
              "DB",
              "FILES",
              "CACHE",
              "QUEUE",
              "SESSION",
              "EXTERNAL",
              "WORKER",
              "CRON",
              "CLI",
              "GENERATED_CODE",
              "NATIVE_EXTENSION"
            ]
          },
          "boundary_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "instrumentation_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "supported_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "excluded_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "escape_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "control_test_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "closure_test_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "failure_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "residual_limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "coverage": {
            "enum": [
              "CLOSED",
              "PARTIAL",
              "UNAVAILABLE"
            ]
          }
        },
        "required": [
          "mechanism_id",
          "dimension",
          "boundary_ref",
          "instrumentation_ref",
          "supported_paths",
          "excluded_paths",
          "escape_paths",
          "control_test_refs",
          "closure_test_refs",
          "failure_refs",
          "residual_limitations",
          "coverage"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "derived_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ]
    },
    "derivation_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "not_applicable_contract_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "attestation_id",
    "project_id",
    "profile_ref",
    "mechanisms",
    "derived_status",
    "derivation_ref",
    "not_applicable_contract_ref"
  ],
  "additionalProperties": false
}
